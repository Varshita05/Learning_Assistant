# Copy to `.env` locally. Do not commit `.env`.
# No real keys in this file.

# --- Production requires APP_ENV=production and both admin credentials ---
APP_ENV=development
SINGLE_USER_USERNAME=
SINGLE_USER_PASSWORD=

# --- Required: direct Groq LLM ---
GROQ_API_KEY=

# --- Optional: Portkey gateway (requires a JSON-object PORTKEY_CONFIG) ---
PORTKEY_API_KEY=

# --- Required: vector DB ---
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=

# --- Optional embedding fallback (used only if the local model fails) ---
GEMINI_API_KEY=

# --- Optional Portkey routing config: valid JSON object; otherwise direct Groq is used ---
PORTKEY_CONFIG=

# --- Required for traces (do not commit credential JSON either) ---
LOGFIRE_TOKEN=

# --- Optional ---
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
PORTKEY_GROQ_SLUG=
PORTKEY_GROQ_SLUG_FALLBACK=
QDRANT_COLLECTION=enterprise_rag
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
BACKEND_URL=http://localhost:8000
